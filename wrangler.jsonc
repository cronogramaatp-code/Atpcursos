{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atpcursos-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atpcursos-staging-db",
      "database_id": "e8bca86c-c018-4ef7-ab85-c5508f9b1caa"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PDFS",
      "bucket_name": "atpcursos-staging-pdfs"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "vars": {
    "ENVIRONMENT": "staging"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
