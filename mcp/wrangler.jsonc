{
 "name":"atpcursos-mcp-staging",
 "main":"src/index.ts",
 "compatibility_date":"2026-10-11",
 "compatibility_flags":["nodejs_compat"],
 "observability":{"enabled":true},
 "vars":{"ENVIRONMENT":"staging"}
